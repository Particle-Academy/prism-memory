{
    "name": "particle-academy/prism-memory",
    "description": "Persistent context and semantic recall for Laravel \u2014 vector storage, remember/recall and token-budget-aware retrieval on top of Prism.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "ai",
        "agents",
        "llm",
        "prism",
        "memory",
        "embeddings",
        "vector-search"
    ],
    "authors": [
        {
            "name": "Wish Born",
            "email": "wish@impact.do"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "laravel/framework": "^12.61.1|^13.12.0",
        "particle-academy/prism": ">=0.114 <1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "particle-academy/prism-harness": "0.4",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Prism\\Memory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "types": "@php vendor/bin/phpstan analyse",
        "format": "@php vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Prism\\Memory\\PrismMemoryServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "suggest": {
        "particle-academy/prism-harness": "Wire memory in as the harness's EvictionSink and ContextRecall, so turns that leave an agent's context window stay reachable by meaning. See src/Harness/. Optional: nothing in this package resolves those classes, so an installation without the harness never loads them."
    }
}
